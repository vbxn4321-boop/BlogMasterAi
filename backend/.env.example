# ===== Naver Blog Automation System =====
# Copy this file to .env and fill in your values

# Gemini API Key (Required for Module 1, 2)
GEMINI_API_KEY=your_gemini_api_key_here

# Naver Blog Settings (Required for Module 4)
NAVER_BLOG_ID=your_blog_id
NAVER_CATEGORY=해외여행

# Social Distribution (Module 5)
AGENT_COUNT=3
PROXY_LIST=http://proxy1:port,http://proxy2:port,http://proxy3:port

# PortOne V2 정기결제(빌링키) — 관리자 콘솔 [결제 연동] 탭에서 발급
PORTONE_API_SECRET=your_portone_v2_api_secret
PORTONE_STORE_ID=your_portone_store_id
PORTONE_CHANNEL_KEY=your_portone_channel_key
PORTONE_WEBHOOK_SECRET=your_portone_webhook_secret
PORTONE_PRO_PLAN_PRICE=29000

# 텔레그램 봇 연동 — @BotFather에서 발급
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# 쿠팡 파트너스 오픈 API — https://partners.coupang.com 에서 발급
COUPANG_ACCESS_KEY=your_coupang_access_key
COUPANG_SECRET_KEY=your_coupang_secret_key

# 유튜브 쇼핑쇼츠 video-engine (Python/FastAPI) 로컬 주소
VIDEO_ENGINE_URL=http://localhost:8001
